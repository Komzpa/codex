{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "CreditsSnapshot": {
      "properties": {
        "balance": {
          "type": "string"
        },
        "has_credits": {
          "type": "boolean"
        },
        "unlimited": {
          "type": "boolean"
        }
      },
      "required": [
        "has_credits",
        "unlimited"
      ],
      "type": "object"
    },
    "GoalExecutionContext": {
      "description": "Bounded canonical facts for a live goal execution.",
      "properties": {
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "currentQuotaSnapshots": {
          "items": {
            "$ref": "#/definitions/GoalQuotaSnapshot"
          },
          "type": "array"
        },
        "currentStage": {
          "$ref": "#/definitions/GoalStageExecutionContext"
        },
        "currentTokenBudget": {
          "format": "int64",
          "type": "integer"
        },
        "finalDeadlineAt": {
          "format": "int64",
          "type": "integer"
        },
        "finalDeadlineOverdueSeconds": {
          "format": "int64",
          "type": "integer"
        },
        "finalDeadlineRemainingPercent": {
          "format": "int64",
          "type": "integer"
        },
        "finalDeadlineRemainingSeconds": {
          "format": "int64",
          "type": "integer"
        },
        "initialQuotaSnapshots": {
          "items": {
            "$ref": "#/definitions/GoalQuotaSnapshot"
          },
          "type": "array"
        },
        "initialTokenBudget": {
          "format": "int64",
          "type": "integer"
        },
        "latestDeliveredArtifact": {
          "type": "string"
        },
        "latestDeliveredAt": {
          "format": "int64",
          "type": "integer"
        },
        "nowAt": {
          "format": "int64",
          "type": "integer"
        },
        "objective": {
          "type": "string"
        },
        "overdueStageCount": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "timeUsedSeconds": {
          "format": "int64",
          "type": "integer"
        },
        "timezone": {
          "type": "string"
        },
        "tokensUsed": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "createdAt",
        "currentQuotaSnapshots",
        "initialQuotaSnapshots",
        "nowAt",
        "objective",
        "overdueStageCount",
        "timeUsedSeconds",
        "tokensUsed"
      ],
      "type": "object"
    },
    "GoalQuotaSnapshot": {
      "properties": {
        "capturedAt": {
          "description": "Unix seconds when this host observed the limits.",
          "format": "int64",
          "type": "integer"
        },
        "limits": {
          "items": {
            "$ref": "#/definitions/RateLimitSnapshot"
          },
          "type": "array"
        },
        "scopeId": {
          "description": "Account/workspace scope to which the limits apply.",
          "type": "string"
        },
        "source": {
          "description": "The provider or runtime that supplied the limits.",
          "type": "string"
        }
      },
      "required": [
        "capturedAt",
        "limits",
        "scopeId",
        "source"
      ],
      "type": "object"
    },
    "GoalStageExecutionContext": {
      "properties": {
        "deadlineAt": {
          "format": "int64",
          "type": "integer"
        },
        "deliveredArtifact": {
          "type": "string"
        },
        "deliveredAt": {
          "format": "int64",
          "type": "integer"
        },
        "expectedResult": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "overdueSeconds": {
          "format": "int64",
          "type": "integer"
        },
        "remainingPercent": {
          "format": "int64",
          "type": "integer"
        },
        "remainingSeconds": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "deadlineAt",
        "expectedResult",
        "id",
        "label",
        "overdueSeconds",
        "remainingSeconds"
      ],
      "type": "object"
    },
    "NullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "PlanType": {
      "enum": [
        "free",
        "go",
        "plus",
        "pro",
        "prolite",
        "team",
        "self_serve_business_prolite",
        "self_serve_business_usage_based",
        "business",
        "ent26",
        "enterprise_cbp_automation",
        "enterprise_cbp_usage_based",
        "enterprise",
        "edu",
        "edu_plus",
        "edu_pro",
        "unknown"
      ],
      "type": "string"
    },
    "RateLimitReachedType": {
      "enum": [
        "rate_limit_reached",
        "workspace_owner_credits_depleted",
        "workspace_member_credits_depleted",
        "workspace_owner_usage_limit_reached",
        "workspace_member_usage_limit_reached"
      ],
      "type": "string"
    },
    "RateLimitSnapshot": {
      "properties": {
        "credits": {
          "$ref": "#/definitions/CreditsSnapshot"
        },
        "individual_limit": {
          "$ref": "#/definitions/SpendControlLimitSnapshot"
        },
        "limit_id": {
          "type": "string"
        },
        "limit_name": {
          "type": "string"
        },
        "normal_model_slug": {
          "description": "Normal model metadata for a quota alias; never a replacement for the request model.",
          "type": "string"
        },
        "plan_type": {
          "$ref": "#/definitions/PlanType"
        },
        "primary": {
          "$ref": "#/definitions/RateLimitWindow"
        },
        "rate_limit_reached_type": {
          "$ref": "#/definitions/RateLimitReachedType"
        },
        "secondary": {
          "$ref": "#/definitions/RateLimitWindow"
        },
        "spend_control_reached": {
          "description": "Backend-reported spend-control state. `None` is unavailable, not a sparse-update recovery.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "RateLimitWindow": {
      "properties": {
        "resets_at": {
          "description": "Unix timestamp (seconds since epoch) when the window resets.",
          "format": "int64",
          "type": "integer"
        },
        "used_percent": {
          "description": "Percentage (0-100) of the window that has been consumed.",
          "format": "double",
          "type": "number"
        },
        "window_minutes": {
          "description": "Rolling window duration, in minutes.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "used_percent"
      ],
      "type": "object"
    },
    "SpendControlLimitSnapshot": {
      "properties": {
        "limit": {
          "type": "string"
        },
        "remaining_percent": {
          "format": "int32",
          "type": "integer"
        },
        "resets_at": {
          "format": "int64",
          "type": "integer"
        },
        "used": {
          "type": "string"
        }
      },
      "required": [
        "limit",
        "remaining_percent",
        "resets_at",
        "used"
      ],
      "type": "object"
    }
  },
  "description": "Context accounting already computed by the engine for the active turn.\n\nOptional fields keep command-hook payloads forwards and backwards compatible when a limit is not defined, while the runtime supplies every available value.",
  "properties": {
    "active_context_tokens": {
      "format": "int64",
      "type": "integer"
    },
    "auto_compact_scope_limit": {
      "format": "int64",
      "type": "integer"
    },
    "auto_compact_scope_tokens": {
      "format": "int64",
      "type": "integer"
    },
    "auto_compact_window_prefill_tokens": {
      "format": "int64",
      "type": "integer"
    },
    "base_window_tokens_remaining": {
      "format": "int64",
      "type": "integer"
    },
    "buffered_auto_compact_limit": {
      "format": "int64",
      "type": "integer"
    },
    "cwd": {
      "type": "string"
    },
    "full_context_window_limit": {
      "format": "int64",
      "type": "integer"
    },
    "full_context_window_limit_reached": {
      "type": "boolean"
    },
    "goal_context": {
      "$ref": "#/definitions/GoalExecutionContext"
    },
    "hook_event_name": {
      "const": "Stop",
      "type": "string"
    },
    "last_assistant_message": {
      "$ref": "#/definitions/NullableString"
    },
    "model": {
      "type": "string"
    },
    "permission_mode": {
      "enum": [
        "default",
        "acceptEdits",
        "plan",
        "dontAsk",
        "bypassPermissions"
      ],
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "stop_hook_active": {
      "type": "boolean"
    },
    "token_limit_reached": {
      "type": "boolean"
    },
    "transcript_path": {
      "$ref": "#/definitions/NullableString"
    },
    "turn_id": {
      "description": "Codex extension: expose the active turn id to internal turn-scoped hooks.",
      "type": "string"
    }
  },
  "required": [
    "cwd",
    "hook_event_name",
    "last_assistant_message",
    "model",
    "permission_mode",
    "session_id",
    "stop_hook_active",
    "transcript_path",
    "turn_id"
  ],
  "title": "stop.command.input",
  "type": "object"
}