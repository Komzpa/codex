{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "NullableString": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "description": "Context accounting already computed by the engine for the active turn.\n\nOptional fields keep command-hook payloads forwards and backwards compatible when a limit is not defined, while the runtime supplies every available value.",
  "properties": {
    "active_context_tokens": {
      "format": "int64",
      "type": "integer"
    },
    "auto_compact_scope_limit": {
      "format": "int64",
      "type": "integer"
    },
    "auto_compact_scope_tokens": {
      "format": "int64",
      "type": "integer"
    },
    "auto_compact_window_prefill_tokens": {
      "format": "int64",
      "type": "integer"
    },
    "base_window_tokens_remaining": {
      "format": "int64",
      "type": "integer"
    },
    "buffered_auto_compact_limit": {
      "format": "int64",
      "type": "integer"
    },
    "cwd": {
      "type": "string"
    },
    "full_context_window_limit": {
      "format": "int64",
      "type": "integer"
    },
    "full_context_window_limit_reached": {
      "type": "boolean"
    },
    "hook_event_name": {
      "const": "Stop",
      "type": "string"
    },
    "last_assistant_message": {
      "$ref": "#/definitions/NullableString"
    },
    "model": {
      "type": "string"
    },
    "permission_mode": {
      "enum": [
        "default",
        "acceptEdits",
        "plan",
        "dontAsk",
        "bypassPermissions"
      ],
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "stop_hook_active": {
      "type": "boolean"
    },
    "token_limit_reached": {
      "type": "boolean"
    },
    "transcript_path": {
      "$ref": "#/definitions/NullableString"
    },
    "turn_id": {
      "description": "Codex extension: expose the active turn id to internal turn-scoped hooks.",
      "type": "string"
    }
  },
  "required": [
    "cwd",
    "hook_event_name",
    "last_assistant_message",
    "model",
    "permission_mode",
    "session_id",
    "stop_hook_active",
    "transcript_path",
    "turn_id"
  ],
  "title": "stop.command.input",
  "type": "object"
}