{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadGoalMutationOrigin": {
      "description": "Distinguishes explicit user actions from automatic goal lifecycle mutations.",
      "enum": [
        "user",
        "automatic"
      ],
      "type": "string"
    },
    "ThreadGoalStage": {
      "properties": {
        "deadlineAt": {
          "description": "Unix seconds at which this deliverable is due.",
          "format": "int64",
          "type": "integer"
        },
        "deliveredArtifact": {
          "description": "Reference to an actually delivered artifact.",
          "type": [
            "string",
            "null"
          ]
        },
        "deliveredAt": {
          "description": "Server-stamped Unix seconds when evidence was recorded.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "expectedResult": {
          "type": "string"
        },
        "id": {
          "description": "Stable user-visible identity. Revisions retain a stage's id.",
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "deadlineAt",
        "expectedResult",
        "id",
        "label"
      ],
      "type": "object"
    },
    "ThreadGoalStatus": {
      "enum": [
        "active",
        "paused",
        "blocked",
        "usageLimited",
        "budgetLimited",
        "complete"
      ],
      "type": "string"
    }
  },
  "properties": {
    "objective": {
      "type": [
        "string",
        "null"
      ]
    },
    "origin": {
      "anyOf": [
        {
          "$ref": "#/definitions/ThreadGoalMutationOrigin"
        },
        {
          "type": "null"
        }
      ],
      "description": "Missing provenance does not supply user authorization."
    },
    "stages": {
      "items": {
        "$ref": "#/definitions/ThreadGoalStage"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/definitions/ThreadGoalStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "type": "string"
    },
    "timezone": {
      "type": [
        "string",
        "null"
      ]
    },
    "tokenBudget": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "threadId"
  ],
  "title": "ThreadGoalSetParams",
  "type": "object"
}